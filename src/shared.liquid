{% assign charts_class = "charts-" | append_random %}
{% assign ai_charts_id = "aichart-" | append_random %}
<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
<script src="https://trmnl.com/js/highcharts/12.3.0/pattern-fill.js"></script>

<script type="module" data-id="{{ instance_id }}">
    // -- Main Charts
    const DISPLAY_TYPE = "{{ trmnl.plugin_settings.custom_fields_values.display }}";
    const CHARTS = document.querySelectorAll(".{{ charts_class }}");
    console.log(CHARTS);
    const data = {{ data | json }};
    CHARTS.forEach(chartContainer => {
        const enableLabels = !chartContainer.classList.contains("hide-labels");
        const statId = chartContainer.dataset.stat;
        const seriesData = data[statId]
            .values()
            .filter(function (entry) {
                {% if trmnl.plugin_settings.custom_fields_values.include_other == "true" %}
                return true;
                {% else %}
                return statId != "languages" || entry.name != "Other";
                {% endif %}
            })
            .take(8)
            .map(function (entry) {
                return {
                    name: entry.name,
                    y: entry.total_seconds,
                    label: entry.text
                }
            })
            .toArray();
        if (DISPLAY_TYPE === "bar_race") {
            Highcharts.chart(chartContainer, {
                title: {
                    text: ""
                },
                legend: {
                    enabled: false
                },
                xAxis: {
                    type: 'category',
                    labels: {
                        style: {
                            fontSize: '1.5em',
                        },
                        className: 'title'
                    }
                },
                yAxis: {
                    visible: false,
                },
                plotOptions: {
                    series: {
                        animation: false,
                        groupPadding: 0,
                        pointPadding: 0.1,
                        borderWidth: 0,
                        colorByPoint: false,
                        color: {
                            pattern: {
                                image: "https://trmnl.com/images/grayscale/gray-5.png",
                                width: 12,
                                height: 12
                            }
                        },
                        dataSorting: {
                            enabled: true,
                            matchByName: true
                        },
                        type: 'bar',
                        dataLabels: {
                            enabled: true,
                            overflow: "justify",
                            className: 'description'
                        }
                    },
                },
                series: [
                    {
                        type: 'bar',
                        data: seriesData,
                        dataLabels: [{
                            enabled: enableLabels,
                            align: 'right',
                            format: '{label}',
                            style: {
                                fontSize: '1.3em',
                                textOutline: '3px contrast'
                            }
                        }]
                    }
                ],
                responsive: {
                    rules: [{
                        condition: {
                            maxWidth: 550
                        },
                        chartOptions: {
                            xAxis: {
                                visible: true,
                                labels: {
                                    style: {
                                        fontSize: '0.9em',
                                    },
                                    className: 'title'
                                }
                            },
                            series: [{
                                dataLabels: [{
                                    enabled: enableLabels,
                                    inside: false,
                                    format: '{label}',
                                    style: {
                                        fontSize: '0.9em',
                                        textOutline: '3px white'
                                    }
                                }]
                            }],
                        }
                    }]
                },
                chart: {
                    animation: false,
                },
                credits: {
                    enabled: false
                }
            });
        } else if (DISPLAY_TYPE === "pie_chart_with_labels" || DISPLAY_TYPE === "pie_chart") {
            Highcharts.chart(chartContainer, {
                title: {
                    text: ""
                },
                legend: {
                    enabled: false
                },
                plotOptions: {
                    series: {
                        animation: false,
                        borderWidth: 0,
                        colorByPoint: true,
                        type: 'pie',
                        size: '100%',
                        innerSize: '80%',
                        dataLabels: {
                            enabled: true,
                            crop: false,
                            distance: '-10%',
                            style: {
                                fontWeight: 'bold',
                                fontSize: '1.5em',
                                textOutline: '3px white'
                            },
                            className: 'description',
                            connectorWidth: 0
                        },
                        colors: [
                            {
                                pattern: {
                                    image: "https://trmnl.com/images/grayscale/gray-2.png",
                                    width: 12,
                                    height: 12
                                }
                            },
                            {
                                pattern: {
                                    image: "https://trmnl.com/images/grayscale/gray-3.png",
                                    width: 12,
                                    height: 12
                                }
                            },
                            {
                                pattern: {
                                    image: "https://trmnl.com/images/grayscale/gray-4.png",
                                    width: 12,
                                    height: 12
                                }
                            },
                            {
                                pattern: {
                                    image: "https://trmnl.com/images/grayscale/gray-5.png",
                                    width: 12,
                                    height: 12
                                }
                            }
                        ]
                    }
                },
                series: [
                    {
                        type: 'pie',
                        data: seriesData
                    }
                ],
                chart: {
                    animation: false,
                },
                credits: {
                    enabled: false
                }
            });
        }
    });

    // -- AI stats Chart
    const AI_CHART = document.querySelector("#{{ ai_charts_id }}");
    if (AI_CHART) {
        const seriesData = [
            {name: "ai", y: data.ai_additions + data.ai_deletions},
            {name: "human", y: data.human_additions + data.human_deletions},
        ];
        Highcharts.chart(AI_CHART, {
            title: {
                text: ""
            },
            legend: {
                enabled: false
            },
            plotOptions: {
                series: {
                    animation: false,
                    borderWidth: 0,
                    colorByPoint: true,
                    type: 'pie',
                    size: '170%',
                    innerSize: '70%',
                    dataLabels: {
                        enabled: false,
                    },
                    enableMouseTracking: false,
                    colors: [
                        {
                            pattern: {
                                image: "https://trmnl.com/images/grayscale/gray-2.png",
                                width: 12,
                                height: 12
                            }
                        },
                        {
                            pattern: {
                                image: "https://trmnl.com/images/grayscale/gray-7.png",
                                width: 12,
                                height: 12
                            }
                        }
                    ]
                }
            },
            series: [
                {
                    type: 'pie',
                    data: seriesData
                }
            ],
            chart: {
                animation: false,
                height: 65,
                width: 65,
                margin: 0,
                spacing: 0,
                custom: {},
                events: {
                    render() {
                        const chart = this,
                            series = chart.series[0];
                        let customLabel = chart.options.chart.custom.label;

                        const prct = Math.round((seriesData[0]["y"] / (seriesData[0]["y"] + seriesData[1]["y"])) * 100);

                        if (!customLabel) {
                            customLabel = chart.options.chart.custom.label =
                                chart.renderer.label(`${prct}%`)
                                    .css({
                                        textAnchor: 'middle',
                                        fontSize: `14px`,
                                        fontFamily: 'var(--description-font-family)',
                                        fontWeight: 'var(--description-font-weight)',
                                        lintHeight: 'var(--description-line-height)',
                                        color: 'var(--framework-text-primary)'
                                    })
                                    .add();
                        }

                        const x = series.center[0] + chart.plotLeft - 2,
                            y = series.center[1] + chart.plotTop -
                                (customLabel.attr('height') / 2);

                        customLabel.attr({
                            x,
                            y
                        });
                    }
                }
            },
            credits: {
                enabled: false
            }
        });
    }
</script>

{% template stat_name %}
{% if name == "operating_systems" %}
    OS
{% else %}
    {{ name | capitalize }}
{% endif %}
{% endtemplate %}

{% template times %}
{% assign _show_times = trmnl.plugin_settings.custom_fields_values.show_times %}
{% assign _show_ai_percentage = trmnl.plugin_settings.custom_fields_values.show_ai_percentage %}
{% if _show_times == "true" or _show_ai_percentage == "true" %}
    <div class="mx--2 gap flex no-shrink stretch-x">
        {% if _show_times == "true" %}
            <div class="grid grid--cols-2">
                <div class="item">
                    <div class="meta"></div>
                    <div class="content">
                        <span class="value value--tnums" data-value-fit="true">
                            {% if small_text %}
                                {{ data.human_readable_total | split: " hrs" | first }} hrs
                            {% else %}
                                {{ data.human_readable_total }}
                            {% endif %}
                        </span>
                        <span class="label text--gray-30">Total</span>
                    </div>
                </div>
                <div class="item">
                    <div class="meta"></div>
                    <div class="content">
                        <span class="value value--tnums" data-value-fit="true">
                            {% if trmnl.plugin_settings.custom_fields_values.include_other == "true" %}
                                {% assign _daily_average = data.human_readable_daily_average_including_other_language %}
                            {% else %}
                                {% assign _daily_average = data.human_readable_daily_average %}
                            {% endif %}
                            {% if small_text %}
                                {{ _daily_average | split: " hrs" | first }} hrs
                            {% else %}
                                {{ _daily_average }}
                            {% endif %}
                        </span>
                        <span class="label text--gray-30">{% unless small_text %}Daily {% endunless %}Average</span>
                    </div>
                </div>
            </div>
        {% endif %}
        {% if _show_ai_percentage == "true" %}
            <div class="no-shrink flex flex--center-y gap--xsmall">
                <div class="no-shrink" id="{{ ai_charts_id }}"></div>
                <span class="no-shrink description text--center">AI<br>-driven</span>
            </div>
        {% endif %}
    </div>
    <div class="divider"></div>
{% endif %}
{% endtemplate %}


{% template items %}
{% assign _stats = trmnl.plugin_settings.custom_fields_values.stats | sort %}
{% assign _stats_size = _stats | size %}
{% if _stats_size > 1 %}
    <!-- MULTIPLE SELECTED -->
    <div class="columns">
        {% for _stat in _stats %}
            <div class="column" data-overflow="true" data-overflow-counter="true">
                <span class="title {% if small_title %}title--small{% endif %}">Top {% render "stat_name", name: _stat %}</span>
                {% for _item in data[_stat] %}
                    <div class="item">
                        <div class="meta">
                            <span class="index">{{ forloop.index }}</span>
                        </div>
                        <div class="content">
                        <span class="title title--small lg:title--large">
                            <p>{{ _item.name }}</p>
                        </span>
                            <span class="description">
                            {{ _item.text }}
                        </span>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endfor %}
    </div>
{% else %}
    <!-- ONLY 1 SELECTED -->
    {% assign _stat = _stats[0] %}
    <span class="title {% if small_title %}title--small{% endif %}">Top {% render "stat_name", name: _stat %}</span>
    <div class="columns" data-overflow-max-cols="4" data-overflow-counter="true">
        <div class="column">
            {% for _item in data[_stat] %}
                <div class="item">
                    <div class="meta">
                        <span class="index">{{ forloop.index }}</span>
                    </div>
                    <div class="content">
                        <span class="title title--small lg:title--base">
                            <p>{{ _item.name }}</p>
                        </span>
                        <span class="description">
                            {{ _item.text }}
                        </span>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endif %}
{% endtemplate %}

{% template charts %}
{% assign _stats = trmnl.plugin_settings.custom_fields_values.stats | sort %}
{% assign _stats_size = _stats | size %}
{% if trmnl.plugin_settings.custom_fields_values.display == "pie_chart_with_labels" %}
    {% if _stats_size > 1 %}
        <div class="stretch flex flex--col">
            <span class="title title--xlarge">Error</span>
            <span class="content">"Pie Chart with labels" can only be used if only one statistic is chosen.</span>
        </div>
    {% else %}
        {% assign _stat = _stats[0] %}
        <span class="title text--center stretch-x {% if small_title %}title--small{% endif %}">Top {% render "stat_name", name: _stat %}</span>
        <div class="columns">
            <div class="column">
                <div class="{{ charts_class }} {% if _stats_size > 3 %}hide-labels{% endif %}"
                     data-stat="{{ _stat }}"></div>
            </div>
            <div class="column" data-overflow="true" data-overflow-counter="true">
                {% for _item in data[_stat] %}
                    <div class="item">
                        <div class="meta">
                            <span class="index">{{ forloop.index }}</span>
                        </div>
                        <div class="content">
                            <span class="title title--small lg:title--large">
                                <p>{{ _item.name }}</p>
                            </span>
                            <span class="description">
                                {{ _item.text }}
                            </span>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}
{% else %}
    <div class="columns">
        {% for _stat in _stats %}
            <div class="column">
                <span class="title text--center {% if small_title %}title--small{% endif %}">Top {% render "stat_name", name: _stat %}</span>
                <div class="{{ charts_class }} {% if _stats_size > 3 %}hide-labels{% endif %}"
                     data-stat="{{ _stat }}"></div>
            </div>
        {% endfor %}
    </div>
{% endif %}
{% endtemplate %}

{% template title_bar %}
<div class="title_bar">
    <img class="image" src="https://wakatime.com/static/img/wakatime.svg">
    <span class="title">{% if data.username %}{{ data.username }} ({{ data.human_readable_range }}){% endif %}</span>
    <span class="instance">{{ trmnl.plugin_settings.instance_name }}</span>
</div>
{% endtemplate %}

{% template error_info %}
<div class="layout w--full h--full">
    <div class="flex flex--row gap--xlarge">
        <div><img src="https://capypara.de/caution.svg" class="w--36"></div>
        <div class="stretch-x">
            <p><span class="title">Failed loading WakaTime Stats</span></p>
            </p>
            <span class="description description--large">
                    {% if errors contains "Unauthorized." %}
                        This plugin requires OAuth authorization, please log in to your WakaTime account using the plugins's
                        settings. If you installed this plugin previously before this was required, you may need to reinstall
                        the plugin.
                    {% else %}
                        <ul>
                            {% for error in errors %}
                                <li>{{ error }}</li>
                            {% endfor %}
                        </ul>
                        <br>
                        If the error persists, try re-authenticating the plugin.
                    {% endif %}
                </span>
            </p>
        </div>
    </div>
</div>
{% endtemplate %}